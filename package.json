{
  "name": "synclounge",
  "version": "6.4.26",
  "description": "Synced playback of Plex content",
  "author": "Chris Alves",
  "bin": "./server.js",
  "files": [
    "dist",
    "config",
    "server.js",
    "cache.js",
    "poster-proxy.js",
    "request-abort.js",
    "packages/syncloungeserver/dist",
    "packages/syncloungeserver/src",
    "packages/syncloungeserver/LICENSE",
    "packages/syncloungeserver/README.md",
    "packages/syncloungeserver/package.json"
  ],
  "scripts": {
    "serve": "vite",
    "build": "npm run build:server && vite build",
    "build:server": "babel packages/syncloungeserver/src --out-dir packages/syncloungeserver/dist --config-file ./packages/syncloungeserver/.babelrc.json",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 src/ packages/syncloungeserver/src/ config/ test/ *.js *.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "npm run build && npm run test:unit",
    "test:node": "node --test test/*.test.js",
    "test:frontend": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run",
    "test:unit": "npm run test:node && npm run test:frontend",
    "test:ci": "npm run test:unit",
    "prepare": "node -e \"if (process.env.SKIP_BUILD !== 'true') require('node:child_process').execSync('npm run build', { stdio: 'inherit' })\"",
    "test:sync-fuzz": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run src/__tests__/sync-seek-harness.test.js src/__tests__/participant-health.test.js",
    "check:dependencies": "npm ls --all",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "nconf": "0.13.0",
    "proxy-addr": "2.0.8",
    "socket.io": "4.8.4",
    "uuid": "14.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "utf-8-validate": "6.0.6"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools-api": "8.2.1",
    "@vue/test-utils": "2.5.1",
    "caf": "15.0.1",
    "cast-mux.js": "npm:mux.js@7.0.3",
    "confusing-browser-globals": "1.0.11",
    "date-fns": "4.4.0",
    "detect-browser": "5.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "sass": "1.108.1",
    "shaka-player": "5.3.4",
    "socket.io-client": "4.8.4",
    "synclounge-libjass": "1.0.0",
    "vanilla-tilt": "1.8.1",
    "vite": "8.3.6",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "vuetify": "4.3.2",
    "vuex": "4.1.0"
  },
  "bugs": {
    "url": "https://github.com/chrisae9/synclounge/issues"
  },
  "homepage": "https://lounge.chis.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisae9/synclounge.git"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bufferutil@4.1.0": true,
    "fsevents@2.3.3": true,
    "utf-8-validate@6.0.6": true
  },
  "overrides": {
    "qs": "6.17.1",
    "glob": "14.0.3",
    "minimatch@>=9": "11.0.4"
  }
}
