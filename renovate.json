{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigests"
  ],
  "enabledManagers": [
    "npm",
    "dockerfile",
    "github-actions"
  ],
  "ignorePaths": [],
  "timezone": "America/New_York",
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "groupName": null
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "forkProcessing": "enabled"
}
